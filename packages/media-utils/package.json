{
  "name": "@vigilkit/media-utils",
  "version": "0.3.1",
  "description": "Shared codec helpers for vigilkit FLV and HLS plugins",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "prepublishOnly": "pnpm build",
  "repository": {
    "type": "git",
    "url": "https://github.com/SnowCrescenter-tech/vigilkit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "video",
    "player",
    "webcodecs",
    "surveillance"
  ]
}
