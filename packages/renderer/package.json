{
    "name":  "@vigilkit/renderer",
    "version":  "0.1.0",
    "description":  "WebGPU, WebGL2 and Canvas2D VideoFrame renderers for vigilkit",
    "type":  "module",
    "license":  "Apache-2.0",
    "sideEffects":  false,
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "files":  [
                  "dist"
              ],
    "scripts":  {
                    "build":  "tsup src/index.ts --format esm --dts --clean",
                    "test":  "vitest run",
                    "typecheck":  "tsc --noEmit"
                },
    "devDependencies":  {
                            "@webgpu/types":  "^0.1.65"
                        },
    "dependencies":  {
                         "vigilkit":  "workspace:*"
                     },
    "publishConfig":  {
                          "access":  "public"
                      },
    "prepublishOnly":  "pnpm build",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/SnowCrescenter-tech/vigilkit.git"
                   },
    "engines":  {
                    "node":  "\u003e=20"
                },
    "keywords":  [
                     "video",
                     "player",
                     "webcodecs",
                     "surveillance"
                 ]
}