{
  "name": "@vigilkit/plugin-hls",
  "version": "0.1.0",
  "description": "HLS media source plugin for vigilkit (m3u8 + MPEG-TS H.264/AAC)",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vigilkit/plugin-sdk": "workspace:*",
    "@vigilkit/media-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
